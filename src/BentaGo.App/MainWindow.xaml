<Window x:Class="BentaGo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BentaGo.App.Features.Help"
        xmlns:ui="clr-namespace:BentaGo.App.Ui"
        Title="BentaGo"
        Width="1366"
        Height="768"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Page}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Rail 216 + the content ScreenPadding (24) lands screen content
                 exactly at x=240 (round-6 reference alignment). -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                <Setter Property="Width" Value="216" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail: BG-004 shell navigation (Alt+1..5 shell-scoped). -->
        <Border x:Name="RailChrome"
                Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource Brush.Brand.Rail}"
                BorderBrush="{DynamicResource Brush.Brand.Rail.Border}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32"
                                Height="32"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                            <TextBlock Text="BG"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BentaGo" Style="{StaticResource RailBrandTitleStyle}" />
                            <TextBlock Text="FIELD SALES" Style="{StaticResource RailBrandMetaStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1"
                        Height="1"
                        Margin="20,0,20,12"
                        Background="{DynamicResource Brush.Brand.Rail.Border}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding RailItems}" Margin="8,0,8,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavRailItemStyle}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}"
                                IsEnabled="{Binding IsEnabled}"
                                ui:FocusTarget.Id="{Binding FocusTargetId}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource NavRailTextStyle}"
                                           VerticalAlignment="Center" />
                                <!-- Navy-tinted keycap chips: readable on the
                                     dark rail (round-4). -->
                                <Border Style="{StaticResource NavRailKeyCapStyle}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding KeyCap}"
                                               Style="{StaticResource NavRailKeyCapTextStyle}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Content region + F1 help overlay. -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl x:Name="ShellContent"
                            Content="{Binding Current}"
                            Focusable="False"
                            Margin="0" />
            <Border Style="{StaticResource HelpOverlayStyle}"
                    Margin="24"
                    Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <views:HelpOverlayView DataContext="{Binding HelpOverlay}" />
            </Border>
        </Grid>

        <!-- Status strip (round-6, reference-faithful): light full-width strip
             below the rail; green dot + dark "Offline — local data" lead,
             muted simulated-data segment, version right. No SQLite/EF claim
             on this branch (lands with the BG-003 merge). -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Surface.Sunken}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatusStripDotStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLeadText" Text="Offline — local data"
                               Style="{StaticResource StatusBarLeadTextStyle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SimulatedLabel}"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                           Style="{StaticResource StatusTextStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
