<Window x:Class="BentaGo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BentaGo.App.Features.Help"
        xmlns:ui="clr-namespace:BentaGo.App.Ui"
        Title="BentaGo"
        Width="1366"
        Height="768"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Page}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail: BG-004 shell navigation (Alt+1..5 shell-scoped). -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface.Sunken}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,1,0">
            <ItemsControl ItemsSource="{Binding RailItems}" Margin="8,16,8,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavRailItemStyle}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}"
                                IsEnabled="{Binding IsEnabled}"
                                ui:FocusTarget.Id="{Binding FocusTargetId}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeyCapStyle}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding KeyCap}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Content region + F1 help overlay. -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl x:Name="ShellContent"
                            Content="{Binding Current}"
                            Focusable="False"
                            Margin="0" />
            <Border Style="{StaticResource HelpOverlayStyle}"
                    Margin="24"
                    Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <views:HelpOverlayView DataContext="{Binding HelpOverlay}" />
            </Border>
        </Grid>

        <!-- Status bar: status, simulated-data annotation, version. -->
        <StatusBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding SimulatedLabel}" Style="{StaticResource StatusTextStyle}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource StatusTextStyle}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>