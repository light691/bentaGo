<Window x:Class="BentaGo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:features="clr-namespace:BentaGo.App.Features.Login"
        Title="BentaGo" Width="1366" Height="768" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type features:LoginViewModel}">
            <features:LoginView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding Login}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <TextBlock Text="Signed in. Ready."
                                               FontSize="30" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <Border Grid.Row="1" Background="#E8EAED" BorderBrush="#D7DAE0" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="#3C4043" />
                <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#5E6470" />
            </Grid>
        </Border>
    </Grid>
</Window>
