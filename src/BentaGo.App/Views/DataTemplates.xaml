<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:features="clr-namespace:BentaGo.App.Features.Login"
                    xmlns:home="clr-namespace:BentaGo.App.Features.PeddlerHome"
                    xmlns:sales="clr-namespace:BentaGo.App.Features.Sales"
                    xmlns:stock="clr-namespace:BentaGo.App.Features.Stock"
                    xmlns:recon="clr-namespace:BentaGo.App.Features.Reconciliation"
                    xmlns:payment="clr-namespace:BentaGo.App.Dialogs.Payment"
                    xmlns:confirm="clr-namespace:BentaGo.App.Dialogs.Confirm">

    <!-- ================================================================
         DataTemplates.xaml - the VM→View map (BG-001 pattern generalized,
         bg-004-synthesis §5.2). MainWindow never names a screen; screens
         bind only to their own view models, and adding a BG-005 screen is
         one DataTemplate + one registration + one ScreenKeys entry.
         ================================================================ -->

    <DataTemplate DataType="{x:Type features:LoginViewModel}">
        <features:LoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type home:PeddlerHomeViewModel}">
        <home:PeddlerHomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sales:SalesViewModel}">
        <sales:SalesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type stock:StockViewModel}">
        <stock:StockView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type recon:ReconciliationViewModel}">
        <recon:ReconciliationView />
    </DataTemplate>

    <!-- Dialogs are hosted by DialogHost through the same map. -->
    <DataTemplate DataType="{x:Type payment:PaymentDialogViewModel}">
        <payment:PaymentDialogView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type confirm:ConfirmDialogViewModel}">
        <confirm:ConfirmDialogView />
    </DataTemplate>
</ResourceDictionary>