<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BentaGo.App.Ui">

    <!-- Shared presentation converters (view-layer glue, no logic). Merged
         with the design-system dictionaries so the STA fixture chain and the
         app chain can never drift. -->
    <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:StringToVisibilityConverter x:Key="StringToVisibility" />
    <ui:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
</ResourceDictionary>
