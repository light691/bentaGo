<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Validation.xaml - the shared error vocabulary (bg-004-synthesis 8).
         One error template per input kind + one field-error text style; the
         shell never hand-places error chrome per field. The message text
         binds the first ValidationError's ErrorContent off the adorned
         element, so it works regardless of the template DataContext.
         Cross-dictionary token references are DynamicResource (merged-
         dictionary isolation, see ScreenStyles.xaml header); the same-file
         ErrorTextStyle reference stays StaticResource.
         ================================================================ -->

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <ControlTemplate x:Key="ErrorTemplate.TextBox">
        <DockPanel LastChildFill="True">
            <!-- Corrective copy renders directly UNDER the field (round-3),
                 anchored left; a text-only strip (no chip) with the MDL2
                 warning triangle so it cannot drift into neighbour columns.
                 Round-7: glyph gap and strip offset sit on the 4px grid. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{DynamicResource Font.Family.IconGlyphs}"
                               Foreground="{DynamicResource Brush.Status.Error}"
                               FontSize="{DynamicResource FontSize.Label}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBlock Text="{Binding AdornedElement.(Validation.Errors)[0].ErrorContent, ElementName=ErrorAdornerPlaceholder}"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>
            </StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Status.Error}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource Corner.S}">
                <AdornedElementPlaceholder x:Name="ErrorAdornerPlaceholder" />
            </Border>
        </DockPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="ErrorTemplate.PasswordBox">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{DynamicResource Font.Family.IconGlyphs}"
                               Foreground="{DynamicResource Brush.Status.Error}"
                               FontSize="{DynamicResource FontSize.Label}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBlock Text="{Binding AdornedElement.(Validation.Errors)[0].ErrorContent, ElementName=ErrorAdornerPlaceholder}"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>
            </StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Status.Error}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource Corner.S}">
                <AdornedElementPlaceholder x:Name="ErrorAdornerPlaceholder" />
            </Border>
        </DockPanel>
    </ControlTemplate>
</ResourceDictionary>
