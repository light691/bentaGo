        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Info}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Corner.M}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- ============================ Navigation ============================ -->
    <!-- Rail items live on the dark navy surface (Brush.Brand.Rail): light
         text, navy hover, and a green accent bar when selected. -->
    <Style x:Key="NavRailItemStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnBrand}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Accent"
                                Width="4"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding BorderBrush}" />
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Corner.M}"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Brand.Rail.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Brand.Rail.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Semi}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Payment method strip: rendered as buttons, never a WPF TabControl. -->
    <Style x:Key="MethodTabButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="{DynamicResource Corner.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Semi}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Misc ============================== -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <!-- WindowStartupLocation and SizeToContent are set by DialogHost
             itself: deferred style-setter creation for those two properties
             throws on this WPF/.NET 10 chain, and they are window policy
             rather than design tokens. -->
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="MaxWidth" Value="{DynamicResource DialogHost.MaxWidth}" />
        <Setter Property="MaxHeight" Value="{DynamicResource DialogHost.MaxHeight}" />
    </Style>

    <Style x:Key="HelpOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource Corner.L}" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.XL}" />
    </Style>

    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyCapStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Corner.S}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Greyed reserved/future affordances: real disabled brushes, never
         opacity-only (opacity ghosts in high contrast). -->
    <Style x:Key="PlaceholderStyle" TargetType="Border" BasedOn="{StaticResource KeyCapStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.State.Disabled.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Disabled.Border}" />
    </Style>

    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.State.Disabled.Fg}" />
    </Style>

    <!-- Inline status glyphs (check / warning triangle): the Segoe MDL2
         Assets family renders reliably; foreground is inherited so status
         banners keep their colour channel without view literals. -->
    <Style x:Key="StatusGlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.IconGlyphs}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>