    <!-- ====================== TextBox / PasswordBox ====================== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height.Default}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Default}" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource ErrorTemplate.TextBox}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Corner.S}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- Watermark (Ui.Watermark.Text): plain disabled
                                 hint that never intercepts input and hides as
                                 soon as the field has text or focus. -->
                            <TextBlock x:Name="WatermarkHint"
                                       Text="{Binding (ui:Watermark.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                            <Setter TargetName="WatermarkHint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="WatermarkHint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.State.Disabled.Bg}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.State.Disabled.Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height.Default}" />
        <Setter Property="Padding" Value="10,4" />
