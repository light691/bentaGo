<UserControl x:Class="BentaGo.App.Features.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BentaGo.App.Ui">
    <!-- Round-6: Peddler ID label (reference term); the Log in button spans
         the exact width of the input fields (the form lives in one column
         with no inset margins anywhere). -->
    <Grid>
        <Border Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="BentaGo"
                               Style="{StaticResource HeaderTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Route selling point of sale"
                               Style="{StaticResource LabelTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Thickness.XS}" />

                    <TextBlock Text="Peddler ID"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="{StaticResource Thickness.M}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="{StaticResource Control.Height.Default}"
                             ui:FocusTarget.Id="Login.UsernameBox"
                             ui:FocusTarget.IsInitial="True" />

                    <TextBlock Text="Password"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="{StaticResource Thickness.M}" />
                    <PasswordBox x:Name="PasswordBox"
                                 MinHeight="{StaticResource Control.Height.Default}"
                                 ui:FocusTarget.Id="Login.PasswordBox" />
                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            Margin="{StaticResource Thickness.M}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                    <!-- Full form width, aligned to the fields exactly
                         (the divider above supplies the 12px gap). -->
                    <Button Content="Log in"
                            Style="{StaticResource Button.PrimaryStyle}"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            ui:FocusTarget.Id="Login.Submit" />

                    <StackPanel Margin="{StaticResource Thickness.M}">
                        <TextBlock Text="Database connected"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>