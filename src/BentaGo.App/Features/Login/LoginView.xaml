<UserControl x:Class="BentaGo.App.Features.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BentaGo.App.Ui">
    <!-- Round-6: User ID label; the Log in button spans
         the exact width of the input fields (the form lives in one column
         with no inset margins anywhere). -->
    <Grid>
        <Border Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource LoginAccentBarStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="BentaGo"
                               Style="{StaticResource HeaderTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Store point of sale"
                               Style="{StaticResource LabelTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Thickness.XS}" />

                    <TextBlock Text="WELCOME BACK"
                               Style="{StaticResource PageEyebrowTextStyle}"
                               Margin="{StaticResource Thickness.XL}" />
                    <TextBlock Text="Login"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="{StaticResource Thickness.XS}" />
                    <TextBlock Text="User ID"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="{StaticResource Thickness.M}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="{StaticResource Control.Height.Default}"
                             ui:FocusTarget.Id="Login.UsernameBox"
                             ui:FocusTarget.IsInitial="True" />

                    <TextBlock Text="Password"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="{StaticResource Thickness.M}" />
                    <PasswordBox x:Name="PasswordBox"
                                 MinHeight="{StaticResource Control.Height.Default}"
                                 ui:FocusTarget.Id="Login.PasswordBox" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                    <!-- Full form width, aligned to the fields exactly.
                         Round-8: the stray divider rule between the password
                         field and the button (no reference backing) is gone;
                         the gap is the button's own top margin. -->
                    <Button Content="Log in"
                            Style="{StaticResource Button.PrimaryStyle}"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            Margin="{StaticResource Thickness.M}"
                            ui:FocusTarget.Id="Login.Submit" />

                    <Grid Margin="{StaticResource Thickness.M}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Local data ready"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
