<UserControl x:Class="BentaGo.App.Dialogs.Payment.PaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BentaGo.App.Ui"
             ui:FocusTarget.Id="Payment.Root"
             FocusManager.FocusedElement="{Binding ElementName=AmountReceivedBox}">
    <UserControl.InputBindings>
        <!-- F6 focuses the method strip (Payment-dialog scope). -->
        <KeyBinding Key="F6" Command="{Binding FocusMethodCommand}" />
    </UserControl.InputBindings>
    <!-- Round-6 reference proportions (900x660 cap): top row = TOTAL left /
         amount + change right; middle = stacked method buttons left / order
         summary right; the keypad is gone (keyboard-first: the amount field
         holds focus, Enter confirms); bottom bar spans the full width. -->
    <Grid Margin="{StaticResource Thickness.S}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top row: TOTAL (left) + amount received / change (right). -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TOTAL" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalText}" Style="{StaticResource DisplayTextStyle}"
                           VerticalAlignment="Center" Margin="{StaticResource Thickness.M}" />
            </StackPanel>
            <!-- Round-8: the field label sits inline LEFT of its input on one
                 centred row (reference layout). The old label floated
                 right-aligned on its own line above, visually attaching
                 itself to the Change value instead of its field. Change uses
                 the same positive-money token as the order summary (the
                 reference shows it green in both places). -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Amount received" Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="AmountReceivedBox"
                         Text="{Binding AmountReceivedText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ScanEditorStyle}"
                         Width="220"
                         Margin="{StaticResource Thickness.S}"
                         ui:FocusTarget.Id="Payment.AmountReceivedBox" />
                <TextBlock Text="Change" Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Thickness.S}" />
                <TextBlock Text="{Binding ChangeText}" Style="{StaticResource MoneyPositiveTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Divider}"
                Margin="{StaticResource Thickness.M}" />

        <!-- Middle: method list (left) + order summary (right). -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Stacked payment methods - full column width, 44 tall. -->
            <StackPanel Grid.Column="0" ui:FocusTarget.Id="Payment.MethodTabs">
                <ItemsControl ItemsSource="{Binding MethodOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PaymentMethodListButtonStyle}"
                                    Command="{Binding DataContext.SelectMethodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}"
                                    Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Order summary card. -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                <StackPanel Margin="{StaticResource CardPadding}">
                    <TextBlock Text="Order summary" Style="{StaticResource TitleTextStyle}" />
                    <Grid Margin="{StaticResource Thickness.M}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource DisplayTextStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            Margin="{StaticResource Thickness.M}" />
                    <Grid Margin="{StaticResource Thickness.M}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount received" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding AmountReceivedText}" Style="{StaticResource MoneyTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="{StaticResource Thickness.M}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Change" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Style="{StaticResource MoneyPositiveTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="Split totals are simulated (BG-005 wires the real tender)."
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource Thickness.M}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom action bar: full width, Complete Payment (green) / Cancel.
             The amount field keeps focus; Enter confirms via IsDefault, Esc
             cancels through the DialogHost input binding. -->
        <Grid Grid.Row="3" Style="{StaticResource ActionBarGridStyle}" Margin="{StaticResource Thickness.M}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Complete Payment (Enter)"
                    Style="{StaticResource Button.ActionBarStyle}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    ui:FocusTarget.Id="Payment.ConfirmButton" />
            <Button Grid.Column="2" Content="Cancel (Esc)"
                    Style="{StaticResource Button.ActionBarOutlineStyle}"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</UserControl>
