<UserControl x:Class="BentaGo.App.Dialogs.Confirm.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource Thickness.L}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Confirm" Style="{StaticResource TitleTextStyle}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Message}"
                   Style="{StaticResource BodyTextStyle}"
                   Margin="{StaticResource Thickness.M}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource Button.QuietStyle}"
                    Command="{Binding CancelCommand}"
                    Margin="{StaticResource Thickness.S}" />
            <Button Content="Confirm"
                    Style="{StaticResource Button.PrimaryStyle}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    Margin="{StaticResource Thickness.S}" />
        </StackPanel>
    </Grid>
</UserControl>