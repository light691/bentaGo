<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- UseWPF brings the UIAutomationClient assembly into scope for the
         state reads (the driver itself ships no WPF UI). -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BentaGo.LaneDriver</AssemblyName>
    <RootNamespace>BentaGo.LaneDriver</RootNamespace>
  </PropertyGroup>

</Project>